{
  "name": "@safetype/angular",
  "version": "1.12.0",
  "description": "Angular directive, pipe, validator and service for SafeType.js content moderation",
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "moderation",
    "profanity",
    "filter",
    "angular",
    "directive",
    "forms",
    "validator"
  ],
  "scripts": {
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.json && node scripts/finalize-dist.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@safetype/core": "workspace:*",
    "@safetype/dom": "workspace:*",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/core": ">=19.0.0",
    "@angular/forms": ">=19.0.0",
    "@safetype/editor": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@angular/forms": {
      "optional": true
    },
    "@safetype/editor": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karammm/safetype.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/karammm/safetype#readme",
  "bugs": {
    "url": "https://github.com/karammm/safetype/issues"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "devDependencies": {
    "@angular/common": "19.2.25",
    "@angular/compiler": "19.2.25",
    "@angular/compiler-cli": "19.2.25",
    "@angular/core": "19.2.25",
    "@angular/forms": "19.2.25",
    "@angular/platform-browser": "19.2.25",
    "@angular/platform-browser-dynamic": "19.2.25",
    "@testing-library/dom": "10.4.0",
    "@testing-library/user-event": "14.5.2",
    "jsdom": "25.0.1",
    "ng-packagr": "19.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.8.3",
    "zone.js": "0.15.1",
    "@safetype/editor": "workspace:*"
  }
}
