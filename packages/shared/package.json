{
  "name": "@safetype/shared",
  "version": "1.13.0",
  "description": "Shared TypeScript contracts for SafeType.js",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karammm/safetype.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/karammm/safetype#readme",
  "bugs": {
    "url": "https://github.com/karammm/safetype/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "profanity",
    "profanity-filter",
    "bad-words",
    "swear-words",
    "censor",
    "moderation",
    "content-moderation",
    "hate-speech",
    "harassment",
    "toxicity",
    "chat",
    "hinglish",
    "hindi",
    "multilingual",
    "typescript"
  ]
}
