{
  "name": "@safetype/dictionaries",
  "version": "1.6.0",
  "description": "Language packs for SafeType.js",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./en": {
      "types": "./dist/en/index.d.ts",
      "import": "./dist/en/index.js",
      "require": "./dist/en/index.cjs"
    },
    "./package.json": "./package.json",
    "./hi-latn": {
      "types": "./dist/hi-latn/index.d.ts",
      "import": "./dist/hi-latn/index.js",
      "require": "./dist/hi-latn/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@safetype/shared": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karammm/safetype.git",
    "directory": "packages/dictionaries"
  },
  "homepage": "https://github.com/karammm/safetype#readme",
  "bugs": {
    "url": "https://github.com/karammm/safetype/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
