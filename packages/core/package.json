{
  "name": "@safetype/core",
  "version": "1.14.0",
  "description": "Framework-independent content moderation engine for SafeType.js",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "moderation",
    "profanity",
    "filter",
    "content-safety",
    "hate-speech",
    "profanity-filter",
    "bad-words",
    "swear-words",
    "censor",
    "content-moderation",
    "harassment",
    "toxicity",
    "chat",
    "hinglish",
    "hindi",
    "multilingual",
    "typescript"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "clean": "rm -rf dist .turbo",
    "test:perf": "vitest run --config vitest.perf.config.ts"
  },
  "dependencies": {
    "@safetype/dictionaries": "workspace:*",
    "@safetype/shared": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karammm/safetype.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/karammm/safetype#readme",
  "bugs": {
    "url": "https://github.com/karammm/safetype/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
